# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Scripts read this file themselves; no dotenv package is needed.

# ---- Contentful source (read-only access for the pipeline) ----------------------------
# The Contentful MCP server (see .mcp.json) authenticates with OAuth via `/mcp` and needs no token here.
# These are only for scripts/export_contentful.py (bulk export).
# Optional overrides. By default the space/environment come from source.space / source.environment in
# mapping/field-mapping.json (space ids are configuration, not secrets, and the mapping approval covers them).
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_SOURCE_ENVIRONMENT=master
# Read-only. Delivery = published entries only; Preview = published + drafts (used first when set).
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# ---- Optional: seeding test content (scripts/seed_contentful.py) -----------------------
# A Content Management API token can WRITE to your space. Only set it while seeding, use a
# sandbox space/environment, and revoke it afterwards. The target must be named explicitly (no default), and the
# script refuses your migration source (mapping source.space/environment) unless you pass --allow-source.
# CONTENTFUL_MANAGEMENT_TOKEN=
# CONTENTFUL_SEED_SPACE=
# CONTENTFUL_SEED_ENVIRONMENT=

# ---- Builder target ---------------------------------------------------------------------
# Builder Private API Key (Organization Settings). Used by scripts/run_migration.py (Write API,
# drafts only), scripts/migrate_assets.py (Upload API) and the read-only verification/SEO scripts.
# The Builder MCP connector itself uses OAuth. The public API key is the Builder space id
# (target.space in mapping/field-mapping.json).
BUILDER_CONTENT_MCP_PK=
